    "Dein Foto zum Ausprobieren hast du schon verwendet. Mit der Vollversion wird jedes deiner Fotos zur Malvorlage, so viele du willst." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Foto zum Ausprobieren hast du schon verwendet. Mit der Vollversion wird jedes deiner Fotos zur Malvorlage, so viele du willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've already used your free photo. With the full version, every photo of yours becomes a template, as many as you like."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà utilisé votre photo d'essai. Avec la version complète, chacune de vos photos devient un modèle, autant que vous voulez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has usado tu foto de prueba. Con la versión completa, cada una de tus fotos se convierte en plantilla, tantas como quieras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già usato la tua foto di prova. Con la versione completa ogni tua foto diventa un modello, quante ne vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お試しの写真はもう使いました。フル版なら、どの写真でも好きなだけぬりえにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체험용 사진은 이미 사용했습니다. 정식 버전에서는 원하는 만큼 모든 사진을 도안으로 만들 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je proeffoto heb je al gebruikt. Met de volledige versie wordt elke foto van jou een sjabloon, zoveel je wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já usou sua foto de teste. Com a versão completa, cada foto sua vira um modelo, quantas quiser."
          }
        }
      }
    },
