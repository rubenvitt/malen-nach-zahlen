    "Das Bild und alles Ausgemalte sind dann weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild und alles Ausgemalte sind dann weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The picture and everything you painted will be gone."
          }
        },
        "fr" : {
          "stringUnit" : {
