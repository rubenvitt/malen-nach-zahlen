    "Alles Ausgemalte wird entfernt, die Vorlage bleibt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles Ausgemalte wird entfernt, die Vorlage bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All paint is removed; the template stays."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute la peinture est effacée, le modèle reste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borra toda la pintura; la plantilla se conserva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il colore viene rimosso, il modello resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塗った部分はすべて消え、下絵は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색칠한 내용은 모두 지워지고 도안은 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle verf wordt verwijderd, de sjabloon blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda a pintura é removida; o modelo continua."
