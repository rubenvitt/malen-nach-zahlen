    "Alles Ausgemalte wird entfernt, die Vorlage bleibt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles Ausgemalte wird entfernt, die Vorlage bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All paint is removed; the template stays."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute la peinture est effacée, le modèle reste."
